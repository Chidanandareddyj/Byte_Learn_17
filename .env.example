# ByteLearn application
APP_URL="http://localhost:3000"
BACKEND_URL="http://127.0.0.1:8000"

# Cursor SDK (create a key in Cursor Dashboard -> Integrations)
CURSOR_API_KEY="cursor_..."
CURSOR_SDK_MODEL="composer-2.5"
CURSOR_SDK_FALLBACK_MODEL="auto"
CURSOR_SDK_MAX_ATTEMPTS="3"
# Optional. On Vercel/Lambda the SDK auto-uses /tmp and HOME=/tmp/bytelearn-home.
# CURSOR_SDK_CWD="/tmp/bytelearn-cursor"
# CURSOR_SDK_STORE_DIR="/tmp/bytelearn-cursor/sdk-agent-store"
# CURSOR_SDK_FORCE_TMP="true"
# Scene coder concurrency. Defaults to 1 on Vercel, 3 locally.
# CURSOR_SCENE_CONCURRENCY="1"

# Speech and storage
ENABLE_TTS="true"
DEEPGRAM_API_KEY=""
DEEPGRAM_TTS_MODEL="aura-2-thalia-en"
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Background render callback
VIDEO_WEBHOOK_SECRET=""
MUX_BUCKET_NAME="muxvideos"
